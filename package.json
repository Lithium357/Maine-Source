{
  "name": "maine-source",
  "version": "0.1.0",
  "description": "A local-first desktop workbench for building traceable text datasets",
  "license": "GPL-3.0-only",
  "author": "Maine-Source contributors",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/preview.mjs",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "spdx-expression-parse": "^4.0.0",
    "spdx-license-ids": "^3.0.22"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.mainesource.desktop",
    "productName": "Maine Source",
    "directories": { "output": "release" },
    "files": ["desktop/**", "src/**", "ui/**", "assets/**", "!ui/preview.mjs", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
