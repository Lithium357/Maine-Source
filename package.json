{
  "name": "maine-source",
  "version": "0.2.3",
  "description": "A local-first desktop workbench for building traceable text datasets",
  "license": "GPL-3.0-only",
  "author": "Maine-Source contributors",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke-sources.mjs",
    "preview": "node scripts/preview.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir --win --x64",
    "notices": "node scripts/notices.mjs",
    "checksums": "node scripts/checksums.mjs",
    "predist": "node scripts/notices.mjs",
    "postdist": "node scripts/checksums.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "pdf-parse": "^2.4.5",
    "spdx-expression-parse": "^4.0.0",
    "spdx-license-ids": "^3.0.22"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.mainesource.desktop",
    "productName": "Maine Source",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "src/**",
      "ui/**",
      "assets/**",
      "!ui/preview.mjs",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "assets/installer-notice.txt"
    }
  }
}
